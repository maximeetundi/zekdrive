# ═══════════════════════════════════════════════════════════════
# ZekDrive — Exemple de Configuration
# Copier ce fichier en .env et remplir les vraies valeurs
# cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ─── Application ────────────────────────────────────────────────
APP_ENV=development
APP_PORT=8080
PLATFORM_NAME=ZekDrive
PLATFORM_COUNTRY=CM
PLATFORM_CURRENCY=XAF
PLATFORM_PHONE_PREFIX=+237
PLATFORM_TIMEZONE=Africa/Douala
PLATFORM_LANG=fr

# ─── Base de données (PostgreSQL + PostGIS) ─────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_NAME=zekdrive
DB_USER=zekdrive
DB_PASSWORD=CHANGE_ME
DB_SSL_MODE=disable
POSTGRES_DB=zekdrive
POSTGRES_USER=zekdrive
POSTGRES_PASSWORD=CHANGE_ME

# ─── Redis ──────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_PASSWORD=

# ─── JWT ────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=CHANGE_ME_RANDOM_64_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_RANDOM_64_CHARS
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── URLs Frontend ──────────────────────────────────────────────
NUXT_PUBLIC_API_URL=http://localhost/api/v1
NUXT_PUBLIC_WS_URL=ws://localhost/ws

# ─── PgAdmin (dev uniquement) ───────────────────────────────────
PGADMIN_EMAIL=admin@zekdrive.cm
PGADMIN_PASSWORD=CHANGE_ME

# ─── SMTP (Email) ───────────────────────────────────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_USER=support@zekdrive.cm
SMTP_PASSWORD=CHANGE_ME
SMTP_FROM_EMAIL=support@zekdrive.cm
SMTP_FROM_NAME=ZekDrive Support
SMTP_USE_TLS=true

# ─── WhatsApp (OpenWA) ──────────────────────────────────────────
WHATSAPP_URL=http://openwa-api:2785
WHATSAPP_API_KEY=CHANGE_ME
WHATSAPP_SESSION_ID=CHANGE_ME

# ─── SMS (OTP) ──────────────────────────────────────────────────
SMS_PROVIDER=twilio
SMS_API_KEY=CHANGE_ME
SMS_API_SECRET=CHANGE_ME
SMS_SENDER_ID=ZekDrive
SMS_SENDER_PHONE=

# ─── Firebase (notifications push mobile) ───────────────────────
FIREBASE_CREDENTIALS_FILE=

# ─── Géolocalisation ────────────────────────────────────────────
NOMINATIM_URL=https://nominatim.openstreetmap.org
OSRM_URL=https://router.project-osrm.org

# ─── Paiements Mobile Money ─────────────────────────────────────
MTN_MOMO_API_KEY=CHANGE_ME
MTN_MOMO_API_SECRET=CHANGE_ME
MTN_MOMO_SUBSCRIPTION_KEY=CHANGE_ME
MTN_MOMO_ENVIRONMENT=sandbox

ORANGE_MONEY_API_KEY=CHANGE_ME
ORANGE_MONEY_API_SECRET=CHANGE_ME
ORANGE_MONEY_MERCHANT_KEY=CHANGE_ME

DOHONE_MERCHANT_KEY=CHANGE_ME
DOHONE_HASH_CODE=CHANGE_ME

CINETPAY_API_KEY=CHANGE_ME
CINETPAY_SITE_ID=CHANGE_ME

STRIPE_PUBLIC_KEY=pk_test_CHANGE_ME
STRIPE_SECRET_KEY=sk_test_CHANGE_ME

# ─── Commission & Tarification ──────────────────────────────────
PLATFORM_COMMISSION_RATE=15
DRIVER_MIN_BALANCE=2000
MIN_WITHDRAWAL=5000
MAX_WITHDRAWAL=500000
RIDE_SEARCH_RADIUS_KM=5
DISPATCH_TIMEOUT_SECONDS=30
SURGE_ENABLED=false
MAINTENANCE_MODE=false

# ─── Support ────────────────────────────────────────────────────
SUPPORT_EMAIL=support@zekdrive.cm
SUPPORT_PHONE=+237690000000
